---
import BaseLayout from '../layouts/BaseLayout.astro';
import { lessons } from '../data/lessons';

const base = import.meta.env.BASE_URL;

const pillars = [
  { id: 'pilar-1', title: 'Fundamentos', filter: 'pilar-1' },
  { id: 'pilar-2', title: 'Ingesta y Segmentación', filter: 'pilar-2' },
  { id: 'pilar-3', title: 'Recuperación Avanzada', filter: 'pilar-3' },
  { id: 'pilar-4', title: 'RAGOps y Evaluación', filter: 'pilar-4' },
  { id: 'pilar-5', title: 'Agentic RAG y GraphRAG', filter: 'pilar-5' },
  { id: 'anexo', title: 'Anexos', filter: 'anexo' },
];
---
<BaseLayout
  title="Guía de RAG"
  description="Guía práctica para construir sistemas RAG en producción: fundamentos, chunking, embeddings, hybrid retrieval, reranking, guardrails, evaluación, agentic RAG, multimodal y GraphRAG."
  keywords="RAG, Retrieval Augmented Generation, LLM, producción, chunking, embeddings, vector store, reranking, GraphRAG, agentic RAG, evaluación RAG"
>
  <main id="content">
    <div class="hero">
      <h1>Guía sencilla de RAG</h1>
      <p class="lead">De la teoría a la implementación. 10 lecciones para construir un solo sistema RAG que funciona en producción: el asistente interno de Acme Corp.</p>
      <div class="meta">
        <span>10 lecciones</span>
        <span>2 anexos</span>
        <span>5 pilares</span>
        <span>21 términos</span>
        <span>15+ fuentes</span>
      </div>
    </div>

    {pillars.map((pillar) => (
      <div id={pillar.id}>
        <h2 class="section-heading">{pillar.title}</h2>
        <hr class="section-rule">
        <ul class="lesson-list">
          {lessons
            .filter(l => l.pillar === pillar.id)
            .map((lesson) => (
              <li class="lesson-item">
                <a href={`${base}lessons/${lesson.slug}`}>
                  <span class="lesson-num">{String(lesson.lessonNum).padStart(2, '0')}</span>
                  <div class="lesson-title">{lesson.title}</div>
                  <p class="lesson-desc">{lesson.desc}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    ))}

    <div class="resources">
      <h2 class="section-heading">Recursos</h2>
      <hr class="section-rule">
      <div class="resources-grid">
        <div class="resource-item">
          <h3>Glosario</h3>
          <p><a href={`${base}reference/glossary`}>21 términos clave</a> del curso, de chunking a GraphRAG.</p>
        </div>
        <div class="resource-item">
          <h3>Repositorio</h3>
          <p><a href="https://github.com/ofermend/hands-on-rag">hands-on-rag</a> — Laboratorio principal con 9 capítulos.</p>
        </div>
        <div class="resource-item">
          <h3>Código fuente</h3>
          <p><a href="https://github.com/anibalalvarezg/rag-lessons">rag-lessons</a> — Lecciones HTML de este curso.</p>
        </div>
      </div>
      <p style="margin-top: var(--sp-6); font-size: 0.9rem; color: var(--text-muted); text-align: center;">Esta guía se basó en el repositorio <a href="https://github.com/ofermend/hands-on-rag">hands-on-rag</a> de Ofir Mendelovich. Los ejemplos de código provienen de ese proyecto bajo licencia Apache 2.0.</p>
    </div>
  </main>
</BaseLayout>
